generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users & access ----------

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_REP
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique // 09xxxxxxxxx, used for OTP login
  name      String
  email     String?
  role      Role     @default(SALES_REP)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers     Customer[]
  leads         Lead[]
  deals         Deal[]
  tasks         Task[]     @relation("TaskAssignee")
  createdTasks  Task[]     @relation("TaskCreator")
  activities    Activity[]
  campaigns     Campaign[]
  automations   Automation[]
}

// ---------- Customers & leads ----------

enum Source {
  WEBSITE
  INSTAGRAM
  REFERRAL
  PHONE
  EXHIBITION
  ADVERTISING
  OTHER
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  company   String?
  source    Source   @default(OTHER)
  notes     String?
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  messages      Message[]
  convertedFrom Lead?

  @@index([ownerId])
  @@index([createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  phone      String?
  email      String?
  company    String?
  source     Source     @default(OTHER)
  status     LeadStatus @default(NEW)
  priority   Priority   @default(MEDIUM)
  notes      String?
  ownerId    String?
  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  customerId String?    @unique // set when the lead is converted
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tasks      Task[]
  activities Activity[]
  messages   Message[]

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

// ---------- Pipeline ----------

enum DealStage {
  NEW
  CONTACTED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Deal {
  id              String    @id @default(cuid())
  title           String
  amount          BigInt    @default(0) // Toman
  stage           DealStage @default(NEW)
  position        Int       @default(0) // order inside a kanban column
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ownerId         String?
  owner           User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  expectedCloseAt DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tasks      Task[]
  activities Activity[]

  @@index([stage, position])
  @@index([ownerId])
  @@index([closedAt])
}

// ---------- Tasks & calendar ----------

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueAt       DateTime
  doneAt      DateTime?
  assigneeId  String
  assignee    User      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([assigneeId, dueAt])
}

// ---------- Timeline (notes, calls, system events) ----------

enum ActivityType {
  NOTE
  CALL
  MEETING
  SMS
  EMAIL
  STATUS_CHANGE
  SYSTEM
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  body       String
  authorId   String?
  author     User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@index([customerId, createdAt])
  @@index([leadId, createdAt])
  @@index([dealId, createdAt])
}

// ---------- Messaging, campaigns, automation ----------

enum Channel {
  SMS
  EMAIL
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

// One outbound SMS/email. Every send goes through the queue and is logged here.
model Message {
  id          String        @id @default(cuid())
  channel     Channel
  to          String
  subject     String?
  body        String
  status      MessageStatus @default(QUEUED)
  error       String?
  providerRef String?
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaignId  String?
  campaign    Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  automationRunId String?
  automationRun   AutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  sentAt      DateTime?

  @@index([campaignId])
  @@index([status])
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  DONE
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  channel     Channel
  subject     String?
  body        String // template; supports {{name}} placeholders
  personalize Boolean        @default(false) // AI rewrites body per recipient
  audience    Json // filter, validated with zod
  status      CampaignStatus @default(DRAFT)
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  startedAt   DateTime?

  messages Message[]
}

enum AutomationTrigger {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  DEAL_STAGE_CHANGED
  CUSTOMER_CREATED
}

model Automation {
  id            String            @id @default(cuid())
  name          String
  trigger       AutomationTrigger
  triggerConfig Json              @default("{}") // e.g. { "stage": "WON" }
  steps         Json // ordered step list, validated with zod
  isActive      Boolean           @default(true)
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  runs AutomationRun[]
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       RunStatus  @default(RUNNING)
  stepIndex    Int        @default(0)
  context      Json // { leadId?, customerId?, dealId? }
  log          Json       @default("[]")
  error        String?
  createdAt    DateTime   @default(now())
  finishedAt   DateTime?

  messages Message[]

  @@index([automationId, createdAt])
}
