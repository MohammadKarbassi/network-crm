# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Database & Redis (local values match docker-compose.yml) ---
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
REDIS_URL="redis://localhost:6379"

# --- App ---
APP_URL="http://localhost:3000"
# Phone number (09xxxxxxxxx) of the first admin, created by `npm run db:seed`
SEED_ADMIN_PHONE=""
SEED_ADMIN_NAME="مدیر سیستم"

# --- SMS: Kavenegar (https://kavenegar.com/rest.html) ---
KAVENEGAR_API_KEY=""
# Lookup template name from the Kavenegar panel; its text must contain %token
KAVENEGAR_OTP_TEMPLATE=""
# Line number for campaign/automation SMS (empty = account default line)
KAVENEGAR_SENDER=""

# Safety net for testing: when set (comma-separated phones/emails), SMS and email go ONLY to these
# recipients; all others are marked failed. Leave empty in production to send to everyone.
MESSAGING_ALLOWLIST=""

# --- Email: SMTP ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Full address, or just a display name like "CX" (then the SMTP_USER address is the sender)
EMAIL_FROM=""

# --- AI: ArvanCloud (OpenAI-compatible). Leave AI_API_KEY empty to disable AI features. ---
AI_BASE_URL="https://api.arvancloudai.ir/v1"
AI_API_KEY=""
AI_MODEL="GPT-4.1-Mini"
